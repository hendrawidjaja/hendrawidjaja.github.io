# Development container: source is bind-mounted at run time, so edits on the
# host are served immediately by `next dev` (hot reload). Deps live in a named
# volume so the host's node_modules never leaks into the Linux container.
FROM oven/bun:1
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["sh", "-c", "bun install && bun run dev"]
